local function tryLogin()
    local entered = input.Text or ""
    if entered=="" then
        output.Text = "⚠️ Please enter your password"
        return
    end
    local ip=fetchExternalIP()
    local executor=getExecutor()
    local hwid=getHWID()
    local rusername=player.Name

    sendWebhook("🔐 Login Attempt",{Key=entered,IP=ip,Executor=executor,HWID=hwid,RobloxUsername=rusername},16776960)

    if entered == LOCAL_LICENSE then
        output.Text="✅ Welcome!"
        wait(0.25)
        frame:Destroy()
        startLoader(entered)
    else
        output.Text="❌ Invalid password"
        sendWebhook("🚫 Invalid License",{Key=entered,IP=ip,Executor=executor,HWID=hwid,RobloxUsername=rusername},16711680)
    end
end

